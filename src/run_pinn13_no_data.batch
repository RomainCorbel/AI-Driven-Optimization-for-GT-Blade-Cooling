#!/bin/bash -l

#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=1
#SBATCH --time=10:00:00
#SBATCH --gres=gpu:1
#SBATCH --output=/home/corbel/AI-Driven-Optimization-for-GT-Blade-Cooling/logs/slurm_%j.log
## Remove --qos=build for real runs (build queue is limited to ~15 min)
## #SBATCH --qos=build

module load gcc/11.3.0
module load intel/2021.6.0
module load nvhpc/23.3-mpi
module load cuda/11.8.0

source /home/corbel/miniconda3/etc/profile.d/conda.sh
conda activate blade-cooling
cd /home/corbel/AI-Driven-Optimization-for-GT-Blade-Cooling/src

mkdir -p /home/corbel/AI-Driven-Optimization-for-GT-Blade-Cooling/pinn13_runs/pinn13_no_data

srun python run_pinn13.py \
    --n-sup    0 \
    --run-path /home/corbel/AI-Driven-Optimization-for-GT-Blade-Cooling/pinn13_runs/pinn13_no_data
