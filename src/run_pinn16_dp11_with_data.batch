#!/bin/bash -l

#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=1
#SBATCH --time=10:00:00
#SBATCH --gres=gpu:1
#SBATCH --mem=16G
#SBATCH --output=/home/corbel/AI-Driven-Optimization-for-GT-Blade-Cooling/logs/slurm_%j.log

module load gcc/11.3.0
module load intel/2021.6.0
module load nvhpc/23.3-mpi
module load cuda/11.8.0

source /home/corbel/miniconda3/etc/profile.d/conda.sh
conda activate blade-cooling
cd /home/corbel/AI-Driven-Optimization-for-GT-Blade-Cooling/src
srun python run_pinn16.py \
    --folder       dp11 \
    --hidden-dim   20 \
    --n-layers     4 \
    --n-sup        500 \
    --project      PINN16 \
    --run-path /home/corbel/AI-Driven-Optimization-for-GT-Blade-Cooling/pinn16/pinn16_dp11_with_data
