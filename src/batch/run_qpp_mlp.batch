#!/bin/bash -l

#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=1
#SBATCH --time=06:00:00
#SBATCH --gres=gpu:1
#SBATCH --mem=32G
#SBATCH --output=/scratch/izar/corbel/AI-Driven-Optimization-for-GT-Blade-Cooling/logs/slurm_%j.log

module load gcc/11.3.0
module load intel/2021.6.0
module load nvhpc/23.3-mpi
module load cuda/11.8.0

source /home/corbel/miniconda3/etc/profile.d/conda.sh
conda activate blade-cooling
cd /scratch/izar/corbel/AI-Driven-Optimization-for-GT-Blade-Cooling/src

srun python run_qpp_mlp.py \
    --project      QPP_MLP \
    --hidden-dim   128 \
    --n-layers     8 \
    --epochs       1000 \
    --lr           5.94e-4 \
    --lr-end       3.46e-4 \
    --batch-size   8192 \
    --patience     300 \
    --min-delta    1e-5 \
    --weight-decay 1.32e-4 \
    --seed         42 \
    --run-path     /scratch/izar/corbel/AI-Driven-Optimization-for-GT-Blade-Cooling/best_MLP
