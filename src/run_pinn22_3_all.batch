#!/bin/bash -l

#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=1
#SBATCH --time=10:00:00
#SBATCH --gres=gpu:1
#SBATCH --mem=32G
#SBATCH --output=/home/corbel/AI-Driven-Optimization-for-GT-Blade-Cooling/logs/slurm_%A_%a.log
#SBATCH --array=0-3

FOLDERS=(dp11 dp11 dp00 dp00)
N_SUPS=(500  0   500  0  )
OUTLET_FRACS=(0.0 0.0 0.70 0.70)
INLET_FRACS=(1.0  1.0  0.33 0.33)
NAMES=(dp11_with_data dp11_no_data dp00_with_data dp00_no_data)

FOLDER=${FOLDERS[$SLURM_ARRAY_TASK_ID]}
N_SUP=${N_SUPS[$SLURM_ARRAY_TASK_ID]}
OUTLET_FRAC=${OUTLET_FRACS[$SLURM_ARRAY_TASK_ID]}
INLET_FRAC=${INLET_FRACS[$SLURM_ARRAY_TASK_ID]}
NAME=${NAMES[$SLURM_ARRAY_TASK_ID]}

module load gcc/11.3.0
module load intel/2021.6.0
module load nvhpc/23.3-mpi
module load cuda/11.8.0

source /home/corbel/miniconda3/etc/profile.d/conda.sh
conda activate blade-cooling
cd /home/corbel/AI-Driven-Optimization-for-GT-Blade-Cooling/src

srun python run_pinn22_3.py \
    --folder              $FOLDER \
    --project             PINN22 \
    --n-train             5000 \
    --n-sup               $N_SUP \
    --outlet-y-min-frac   $OUTLET_FRAC \
    --inlet-y-max-frac    $INLET_FRAC \
    --run-path /home/corbel/AI-Driven-Optimization-for-GT-Blade-Cooling/pinn22_3_runs/pinn22_3_${NAME}
