#!/bin/bash -l

#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=1
#SBATCH --time=10:00:00
#SBATCH --gres=gpu:1
#SBATCH --mem=32G
#SBATCH --output=/home/corbel/AI-Driven-Optimization-for-GT-Blade-Cooling/logs/slurm_%A_%a.log
#SBATCH --array=0-3

FOLDERS=(      dp11        dp11         dp00         dp00       )
N_SUPS=(        500           0          500            0        )
OUTLET_FRACS=(  0.0         0.0         0.70          0.70       )
INLET_FRACS=(   1.0         1.0         0.33          0.33       )
WALL_Y1S=(      -1          -1         0.1816        0.1816      )
WALL_Y2S=(      -1          -1         0.3632        0.3632      )
NAMES=(  dp11_with_data  dp11_no_data  dp00_with_data  dp00_no_data  )

# Geometric/flow parameters per DP
ARS=(           7.5         7.5          7.5            7.5       )
E_DHS=(       0.074       0.074        0.074          0.074       )
P_ES=(          8.0         8.0          8.0            8.0       )
ALPHAS=(       60.0        60.0         60.0           60.0       )
RES=(        100000      100000       100000         100000       )

FOLDER=${FOLDERS[$SLURM_ARRAY_TASK_ID]}
N_SUP=${N_SUPS[$SLURM_ARRAY_TASK_ID]}
OUTLET_FRAC=${OUTLET_FRACS[$SLURM_ARRAY_TASK_ID]}
INLET_FRAC=${INLET_FRACS[$SLURM_ARRAY_TASK_ID]}
WALL_Y1=${WALL_Y1S[$SLURM_ARRAY_TASK_ID]}
WALL_Y2=${WALL_Y2S[$SLURM_ARRAY_TASK_ID]}
NAME=${NAMES[$SLURM_ARRAY_TASK_ID]}
AR=${ARS[$SLURM_ARRAY_TASK_ID]}
E_DH=${E_DHS[$SLURM_ARRAY_TASK_ID]}
P_E=${P_ES[$SLURM_ARRAY_TASK_ID]}
ALPHA=${ALPHAS[$SLURM_ARRAY_TASK_ID]}
RE=${RES[$SLURM_ARRAY_TASK_ID]}

module load gcc/11.3.0
module load intel/2021.6.0
module load nvhpc/23.3-mpi
module load cuda/11.8.0

source /home/corbel/miniconda3/etc/profile.d/conda.sh
conda activate blade-cooling
cd /home/corbel/AI-Driven-Optimization-for-GT-Blade-Cooling/src

srun python run_pinn24.py \
    --folder              $FOLDER \
    --project             PINN24 \
    --n-train             5000 \
    --n-sup               $N_SUP \
    --outlet-y-min-frac   $OUTLET_FRAC \
    --inlet-y-max-frac    $INLET_FRAC \
    --wall-y1             $WALL_Y1 \
    --wall-y2             $WALL_Y2 \
    --ar                  $AR \
    --e-dh                $E_DH \
    --p-e                 $P_E \
    --alpha-rib           $ALPHA \
    --re                  $RE \
    --debug \
    --run-path /home/corbel/AI-Driven-Optimization-for-GT-Blade-Cooling/pinn24_runs/pinn24_${NAME}
