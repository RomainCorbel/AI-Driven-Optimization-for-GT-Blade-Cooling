#!/bin/bash -l

#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=1
#SBATCH --time=24:00:00
#SBATCH --gres=gpu:1
#SBATCH --mem=128G
#SBATCH --output=/scratch/izar/corbel/AI-Driven-Optimization-for-GT-Blade-Cooling/logs/slurm_%j.log

module load gcc/11.3.0
module load intel/2021.6.0
module load nvhpc/23.3-mpi
module load cuda/11.8.0

source /home/corbel/miniconda3/etc/profile.d/conda.sh
conda activate blade-cooling
cd /scratch/izar/corbel/AI-Driven-Optimization-for-GT-Blade-Cooling/src

srun python run_pinn.py \
    --project    PINN27 \
    --hidden-dim 128 \
    --n-layers   6 \
    --epochs     5000 \
    --lr         3.6774e-3 \
    --lr-end     1e-4 \
    --n-train    10000 \
    --n-sup      500 \
    --n-test     10000 \
    --seed       42 \
    --w-pde      1.0 \
    --w-bc       1.0 \
    --w-sup      1.0 \
    --w-sup-p    1.0 \
    --run-path   /scratch/izar/corbel/AI-Driven-Optimization-for-GT-Blade-Cooling/best_PINN
