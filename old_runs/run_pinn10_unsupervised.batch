#!/bin/bash -l

#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=1
#SBATCH --time=10:00:00
#SBATCH --gres=gpu:1
#SBATCH --output=/home/corbel/AI-Driven-Optimization-for-GT-Blade-Cooling/pinn10_unsupervised/log_pinn10.txt
## Remove --qos=build for real runs (build queue is limited to ~15 min)
## #SBATCH --qos=build

## here we are rerunning xavier with much less collocation point, sin activation function, and xavier only on the layer, then he normal, also i added a little offset to the vx loss :-)
module load gcc/11.3.0
module load intel/2021.6.0
module load nvhpc/23.3-mpi
module load cuda/11.8.0

source /home/corbel/miniconda3/etc/profile.d/conda.sh
conda activate blade-cooling
cd /home/corbel/AI-Driven-Optimization-for-GT-Blade-Cooling/src
srun python pinn10_unsupervised.py